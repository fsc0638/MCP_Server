# MCP Server Configuration Template
# Standardized environment variables for cross-platform support

# The root directory for all skills
SKILLS_HOME=Agent_skills/skills

# API Keys (Do not commit actual keys to GitHub)
GEMINI_API_KEY=your_gemini_key_here
OPENAI_API_KEY=your_openai_key_here
ANTHROPIC_API_KEY=your_claude_key_here

# Default Models
GEMINI_MODEL=gemini-2.0-flash
OPENAI_MODEL=gpt-4o
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Token Limits (Responses API)
# gpt-4o max: 16384, o1/o3: up to 100000
OPENAI_MAX_OUTPUT_TOKENS=16384

# LINE Bot Model Routing (LLM-as-a-Router)
# Set LINE_ROUTER_ENABLED=false to skip router and use LINE_MODEL_MINI as default
LINE_ROUTER_ENABLED=true
LINE_MODEL_ROUTER=gpt-4.1-nano
LINE_MODEL_NANO=gpt-4.1-nano
LINE_MODEL_MINI=gpt-4.1-mini
LINE_MODEL_FULL=gpt-4.1
LINE_MODEL_CHUNK_SUMMARY=gpt-4.1-mini
LINE_MODEL_CHUNK_FINAL=gpt-4.1

# Security Settings
STRICT_MODE=true
UMA_STREAMING_ENABLED=true
# Use native chat path first; unsupported scenarios will fallback to legacy bridge.
MCP_CHAT_NATIVE=false

# LINE Messaging API (Do not commit actual keys to GitHub)
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here

# LINE Login (Web) (Do not commit actual keys to GitHub)
LINE_LOGIN_CHANNEL_ID=your_line_login_channel_id_here
LINE_LOGIN_CHANNEL_SECRET=your_line_login_channel_secret_here
LINE_LOGIN_CALLBACK_URL=https://your-domain.example/api/auth/line/callback
LINE_LOGIN_SCOPE=openid profile

# Notion Integration (for mcp-meeting-to-notion skill)
NOTION_TOKEN=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
# MEETING_LLM_MODEL=gpt-4.1-mini  # Optional: override LLM model for meeting pipeline

# Google Workspace Integration (for mcp-google-calendar, mcp-google-meet)
# Hybrid mode: Service Account (shared calendar) + personal OAuth (Meet + personal calendar)
#
# Service Account: download JSON key from GCP Console → IAM → Service Accounts → Keys
# Then add the SA email to target calendar's sharing settings (permission: Make changes to events)
GOOGLE_SERVICE_ACCOUNT_KEY=workspace/credentials/service_account.json
# Calendar ID for SA mode (your email that shared the calendar with SA)
# Find it: Google Calendar → Settings → target calendar → "Calendar ID"
GOOGLE_CALENDAR_ID=your_email@gmail.com
#
# Personal OAuth: Create OAuth 2.0 Client ID (Web application) at GCP Console → APIs → Credentials
# Required API: Google Calendar API
# Add redirect URIs: localhost + ngrok URL
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8500/api/auth/google/workspace/callback
