{
  "template_id": "file_analyze_notion",
  "display_name": "檔案分析 + 寫入 Notion",
  "description": "分析上傳的 PDF/DOCX/Excel 後寫入 Notion",
  "category": "document",
  "icon": "📄",
  "question_match": {
    "purpose": ["資料整理"],
    "input_source": ["檔案"],
    "output_target": ["Notion", "摘要"]
  },
  "workflow": {
    "version": "1.0",
    "trigger": {"enabled": false, "mode": "confirm", "priority": 10, "patterns": [], "schedule": ""},
    "variables": {
      "global_inputs": ["filePath"],
      "env_requirements": ["NOTION_TOKEN", "NOTION_DATABASE_ID"],
      "definitions": [
        {"name": "filePath", "type": "string", "source": "user_input", "required": true, "description": "要分析的檔案路徑", "default_value": ""}
      ]
    },
    "blocks": [
      {"id": 1, "type": "start", "x": 50, "y": 100, "label": "開始", "config": {}},
      {"id": 2, "type": "pdf-llm-analyzer", "x": 230, "y": 100, "label": "分析檔案", "config": {"params": {"file_path": {"source": "variable", "value": "${filePath}"}}}},
      {"id": 3, "type": "notion-crud", "x": 410, "y": 100, "label": "寫入 Notion", "config": {"params": {}}},
      {"id": 4, "type": "end", "x": 590, "y": 100, "label": "結束", "config": {}}
    ],
    "connections": [{"from": 1, "to": 2}, {"from": 2, "to": 3}, {"from": 3, "to": 4}]
  }
}
