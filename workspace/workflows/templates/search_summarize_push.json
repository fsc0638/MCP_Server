{
  "template_id": "search_summarize_push",
  "display_name": "搜尋 + 摘要 + LINE 推播",
  "description": "定期搜尋主題關鍵字，摘要後推送到 LINE",
  "category": "information",
  "icon": "📰",
  "question_match": {
    "purpose": ["情報/新聞"],
    "input_source": ["文字"],
    "output_target": ["LINE 推播", "摘要"]
  },
  "workflow": {
    "version": "1.0",
    "trigger": {"enabled": false, "mode": "confirm", "priority": 10, "patterns": [], "schedule": ""},
    "variables": {
      "global_inputs": ["searchQuery"],
      "env_requirements": ["TAVILY_API_KEY"],
      "definitions": [
        {"name": "searchQuery", "type": "string", "source": "user_input", "required": true, "description": "搜尋關鍵字", "default_value": ""}
      ]
    },
    "blocks": [
      {"id": 1, "type": "start", "x": 50, "y": 100, "label": "開始", "config": {}},
      {"id": 2, "type": "web-search", "x": 230, "y": 100, "label": "搜尋主題", "config": {"params": {"query": {"source": "variable", "value": "${searchQuery}"}}}},
      {"id": 3, "type": "end", "x": 410, "y": 100, "label": "結束", "config": {}}
    ],
    "connections": [{"from": 1, "to": 2}, {"from": 2, "to": 3}]
  }
}
